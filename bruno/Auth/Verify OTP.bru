meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-otp
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

body:json {
  "name": "Example Reader",
  "code": "{{otpCode}}"
}

script:post-response {
  bru.setEnvVar('token', res.body.token);
}
